{
  "name": "cdp-browser-mcp",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "chrome-devtools-mcp": "1.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "playwright": "1.65.1"
  },
  "description": "Shared Google Chrome (current Stable or newer) sessions with owned tabs and official DevTools MCP",
  "license": "MIT",
  "bin": {
    "cdp-browser-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/*.md",
    "examples",
    "skills",
    "NOTICE",
    "third_party"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "spike": "node spike/probe.mjs",
    "test:headed": "STEWARD_HEADED=1 npm test",
    "pretest": "npm run build",
    "format:check": "prettier --check src test spike examples skills README.md docs CONTRIBUTING.md package.json"
  },
  "author": {
    "name": "Tsutomu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tsutomu-miku/cdp-browser-mcp.git"
  },
  "keywords": [
    "mcp",
    "cdp",
    "browser",
    "multi-agent",
    "chrome-devtools"
  ],
  "bugs": {
    "url": "https://github.com/Tsutomu-miku/cdp-browser-mcp/issues"
  },
  "homepage": "https://github.com/Tsutomu-miku/cdp-browser-mcp#readme"
}
